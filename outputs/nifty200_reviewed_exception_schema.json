{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed NIFTY 200 source exception row",
  "type": "object",
  "required": [
    "filename",
    "pdf_sha256",
    "official_url",
    "archive_title",
    "announcement_date",
    "classification",
    "page_ref",
    "event_effective_date",
    "reference_close_date",
    "entity",
    "action",
    "event_symbol",
    "identity_symbol",
    "isin",
    "status",
    "linked_notice",
    "review_note",
    "from_isin",
    "to_isin"
  ],
  "properties": {
    "filename": {"type": "string"},
    "pdf_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "official_url": {"type": "string", "format": "uri"},
    "archive_title": {"type": "string"},
    "announcement_date": {"type": "string", "format": "date"},
    "classification": {"type": "string", "enum": ["amendment_deferment", "corporate_action_identity_bridge", "descendant_only_no_parent_change", "parent_prose_index_list"]},
    "page_ref": {"type": "string"},
    "event_effective_date": {"type": "string"},
    "reference_close_date": {"type": "string"},
    "entity": {"type": "string"},
    "action": {"type": "string", "enum": ["defer_rebalance", "exclude", "exclude_revoked", "include", "include_revoked", "isin_bridge", "no_parent_membership_change", "revoke_include"]},
    "event_symbol": {"type": "string"},
    "identity_symbol": {"type": "string"},
    "isin": {"type": "string"},
    "status": {"type": "string", "enum": ["deferred", "deferred_proposal", "no_parent_change", "operative", "revoked"]},
    "linked_notice": {"type": "string"},
    "review_note": {"type": "string"},
    "from_isin": {"type": "string"},
    "to_isin": {"type": "string"}
  },
  "additionalProperties": false
}
